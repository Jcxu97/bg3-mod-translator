<Window x:Class="BG3LocTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BG3LocTool.App"
        Title="BG3 Mod Translator" Height="760" Width="1280" MinHeight="600" MinWidth="1100"
        FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="DropZone" TargetType="Border">
            <Setter Property="Background" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#B8C2D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="380" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="500" />
        </Grid.ColumnDefinitions>

        <!-- ============================ LEFT: 选项 ============================ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding GlossaryStatus}" Foreground="#3F6B3F" FontSize="11" Margin="2,0,0,6"
                           ToolTip="字典在编译时打包进 Core.dll,运行时不依赖任何外部文件。整句反查命中跳过 AI;术语进 system prompt 强约束 + 输出后校验。" />
                <Border Background="#EEF2F8" BorderBrush="#B8C2D1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="工作模式" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="🆕 从零翻译" IsChecked="{Binding IsScratchMode}" GroupName="Mode" Margin="0,0,16,0" />
                            <RadioButton Content="🔄 版本更新" IsChecked="{Binding IsUpgradeMode}" GroupName="Mode" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModeHint}" Foreground="#566375" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                </Border>

                <GroupBox Header="1. 输入 Mod (.pak / .zip / 文件夹)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DropZone}"
                                AllowDrop="True" Drop="InputDrop_Drop" DragOver="AnyDrop_DragOver">
                            <TextBlock Text="{Binding InputSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Content="文件" Margin="6,0,0,0" Padding="8,4" Click="BrowseInputFile_Click" />
                        <Button Grid.Column="2" Content="目录" Margin="4,0,0,0" Padding="8,4" Click="BrowseInputFolder_Click" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. 旧版汉化包 (升级模式必填)"
                          Visibility="{Binding IsUpgradeMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DropZone}"
                                AllowDrop="True" Drop="RefDrop_Drop" DragOver="AnyDrop_DragOver">
                            <TextBlock Text="{Binding ReferenceSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Content="文件" Margin="6,0,0,0" Padding="8,4" Click="BrowseRefFile_Click" />
                        <Button Grid.Column="2" Content="目录" Margin="4,0,0,0" Padding="8,4" Click="BrowseRefFolder_Click" />
                        <Button Grid.Column="3" Content="✕" Margin="4,0,0,0" Padding="8,4" Command="{Binding ClearReferenceCommand}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="3. AI 翻译 (OpenAI 兼容端点)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="预设" VerticalAlignment="Center" Margin="0,2" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Key" VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. 翻译包元数据">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="作者" VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Column="1" Margin="0,2,8,2" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="版本" VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Column="3" Margin="0,2" Text="{Binding VersionText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="5. 输出">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="目录" VerticalAlignment="Center" Margin="0,2" />
                            <TextBox Grid.Column="1" Margin="0,2" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="浏览" Margin="6,0,0,0" Padding="8,4" Click="BrowseOutput_Click" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="文件名" VerticalAlignment="Center" Margin="0,2" />
                            <TextBox Grid.Column="1" Margin="0,2" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="留空自动从 mod 名生成。最终输出为 &lt;文件名&gt;.pak + &lt;文件名&gt;.zip" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <WrapPanel Margin="0,8,0,4">
                    <Button Content="⚡ 一键生成" FontSize="14" Padding="14,8" FontWeight="SemiBold" Margin="0,0,6,4"
                            Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    <Button Content="🧪 试译 5 条" Padding="10,8" Margin="0,0,6,4"
                            Command="{Binding DryRunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    <Button Content="取消" Padding="14,8" Margin="0,0,6,4"
                            Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
                </WrapPanel>

                <TextBlock Margin="0,12,0,4" Foreground="#566375" FontSize="11" Text="其他" />
                <WrapPanel>
                    <Button Content="📂 编辑已有 CHS" Padding="8,4" Margin="0,0,6,4" FontSize="11"
                            Command="{Binding OpenExistingChsForEditCommand}" />
                    <Button Content="🗄️ 缓存" Padding="8,4" Margin="0,0,6,4" FontSize="11"
                            Command="{Binding ManageCacheCommand}" />
                </WrapPanel>

                <StackPanel Margin="0,8,0,0">
                    <ProgressBar Height="16" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,2,0,0" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E0E5EC" />

        <!-- ============================ RIGHT: 日志 + 中英对照 ============================ -->
        <TabControl Grid.Column="2" Margin="2,0,0,0">
            <TabItem Header="📜 日志">
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="LogBox_TextChanged" />
            </TabItem>
            <TabItem Header="📋 中英对照 / 编辑">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,6"
                               Visibility="{Binding HasEmbeddedEditor, Converter={StaticResource InverseBoolToVis}}"
                               Foreground="#566375" FontStyle="Italic" TextWrapping="Wrap"
                               Text="先点 [⚡ 一键生成] 跑一次翻译,这里就会显示中英对照表(可直接编辑)。也可以先勾「翻译完不自动打包」做完之后再在这里审核。" />

                    <Grid Grid.Row="1" Margin="0,0,0,6"
                          Visibility="{Binding HasEmbeddedEditor, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="过滤" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding EmbeddedEditor.FilterModes}" SelectedItem="{Binding EmbeddedEditor.SelectedFilterMode}" />
                        <TextBlock Grid.Column="2" Text="搜索" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Grid.Column="3" Text="{Binding EmbeddedEditor.FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4" Text="{Binding EmbeddedEditor.StatusSummary}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#566375" />
                        <Button Grid.Column="5" Content="💾 保存" Padding="8,4" Margin="8,0,0,0" Command="{Binding EmbeddedEditor.SaveCommand}" />
                        <Button Grid.Column="6" Content="📦 导出 pak" Padding="8,4" Margin="4,0,0,0" Command="{Binding EmbeddedEditor.ExportCommand}" IsEnabled="{Binding EmbeddedEditor.IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Column="7" Content="✏️ 大窗口" Padding="8,4" Margin="4,0,0,0" Command="{Binding OpenEditorCommand}" />
                    </Grid>

                    <DataGrid x:Name="MainEmbeddedGrid" Grid.Row="2" ItemsSource="{Binding EmbeddedEditor.FilteredRows}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="32" MaxColumnWidth="600"
                              AlternatingRowBackground="#F9FAFC"
                              Visibility="{Binding HasEmbeddedEditor, Converter={StaticResource BoolToVis}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext.EmbeddedEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="🔍 查官方译法 (BG3 vanilla)"
                                                      Command="{Binding PlacementTarget.Tag.LookupOfficialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Handle" Binding="{Binding HandleShort}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="v" Binding="{Binding Version}" IsReadOnly="True" Width="36" />
                            <DataGridTextColumn Header="来源" Binding="{Binding SourceBadge}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="English" Binding="{Binding English}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="中文" Binding="{Binding Chinese, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="AcceptsReturn" Value="True" /></Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="状态" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FFE6E6" BorderBrush="#E08080" BorderThickness="1" CornerRadius="3" Padding="3,1" Margin="0,0,3,0"
                                                    Visibility="{Binding IsPlaceholderOk, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="❗占位" FontSize="11" Foreground="#A00000" />
                                            </Border>
                                            <Border Background="#FFF5DD" BorderBrush="#D8B060" BorderThickness="1" CornerRadius="3" Padding="3,1" Margin="0,0,3,0"
                                                    Visibility="{Binding IsTranslated, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="🆕未译" FontSize="11" Foreground="#806000" />
                                            </Border>
                                            <Border Background="#E2F0FF" BorderBrush="#80A0D0" BorderThickness="1" CornerRadius="3" Padding="3,1"
                                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="✏️改" FontSize="11" Foreground="#204080" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
